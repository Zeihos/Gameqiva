# GAMEQIVA: пример переменных окружения (без реальных ключей)
# Скопируйте в .env для локального запуска. Файл .env исключён из Git.
DRY_RUN=1
PREVIEW_HOURS=24

# Достаточно одного AI-провайдера
GROQ_API_KEY=
GEMINI_API_KEY=

# Токен сообщества для публикации в VK (имя оставлено для совместимости)
VK_USER_TOKEN=
VK_GROUP_SCREEN_NAME=gameqiva
VK_GROUP_ID=

# Необязательный токен пользователя для загрузки фотографий VK
VK_PHOTO_USER_TOKEN=

TG_BOT_TOKEN=
TG_CHAT_ID=@gameqivo
